{
  "name": "noone-server",
  "version": "1.0.0",
  "private": true,
  "description": "noone — нэргүй бодит цагийн чатын Socket.IO сервер",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
