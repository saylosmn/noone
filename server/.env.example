# ---- noone сервер ----
PORT=4000

# Frontend-ийн хаяг(ууд), таслалаар тусгаарлана. Production: https://таны-апп.vercel.app
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# true бол *.vercel.app доорх бүх preview хаягийг зөвшөөрнө
ALLOW_VERCEL_PREVIEWS=false
# Render/Proxy-ийн ард ажиллах үед true (x-forwarded-for-оос IP авах)
TRUST_PROXY=false

# Хослуулалт
INTEREST_WAIT_MS=6000
RECONNECT_GRACE_MS=20000
REMATCH_COOLDOWN_MS=15000
MAX_MESSAGE_LENGTH=1000

# Спамын хязгаар
LIMIT_CONNECT_PER_MINUTE=30
# 10 мессеж хүртэл дараалан, дараа нь секундэд 3
LIMIT_MESSAGE_BURST=10
LIMIT_MESSAGE_PER_SECOND=3

# Мэдээлэл (report). Хоосон бол зөвхөн санах ойд хадгална.
REPORT_LOG_FILE=
REPORT_HASH_SALT=change-me-to-a-long-random-string
REPORT_BAN_THRESHOLD=3
REPORT_BAN_MS=900000
# Тохируулбал GET /api/admin/reports (Authorization: Bearer <token>) ажиллана
ADMIN_TOKEN=

# Web Push — `npm run vapid` командаар үүсгэнэ. Хоосон бол Web Push ажиллахгүй
# (tab нээлттэй үеийн browser мэдэгдэл ажилласаар байна).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# client/dist байвал frontend-ийг энэ серверээс хамт үйлчлэх эсэх
SERVE_CLIENT=true
